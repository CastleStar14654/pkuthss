% \paragraph{西文字体}
%    在 Windows 与 macOS 上使用 Times New Roman、Arial 以及 Courier New；在 Linux
%    上使用 TeX Gyre 系列。TeX Gyre 系列字体使用文件名指定，以便于 MiK\TeX{} on-the-fly
%    安装。Times New Roman 需要手动打开连字。
%    \begin{macrocode}
\bool_lazy_and:nnTF
  { \bool_not_p:n { \l_@@_fontset_use_gyre_bool } }
  {
    \bool_lazy_any_p:n
      {
        { \l_@@_fontset_required_bool }
        { \sys_if_platform_windows_p: }
        { \file_if_exist_p:n { /System/Library/Fonts/Menlo.ttc } }
      }
  }
  {
    \setmainfont { Times~New~Roman } [ Ligatures = Rare ]
    \setsansfont { Arial }
    \setmonofont { Courier~New }
  }
  {
    \setmainfont { texgyretermes }
      [
        Extension      = .otf,
        UprightFont    = *-regular,
        BoldFont       = *-bold,
        ItalicFont     = *-italic,
        BoldItalicFont = *-bolditalic
      ]
    \bool_if:NTF \l_@@_fontset_use_arial_bool
      { \setsansfont { Arial } }
      { \setsansfont { TeX~Gyre~Heros } }
    \setmonofont { TeX~Gyre~Cursor }
  }
%    \end{macrocode}
