\RenewDocumentCommand \LARGE { }
  { \@@_setfontsize:Nnnn \LARGE { 16bp } { } { 1 } }
%    \end{macrocode}
%    \cs{huge} 和 \cs{Huge} 分别用于封面上的标题和“研究生学位论文”，26bp 和 36bp，单倍行距。
%    \begin{macrocode}
\RenewDocumentCommand \huge { }
  { \@@_setfontsize:Nnnn \huge { 26bp } { } { 1 } }
\RenewDocumentCommand \Huge { }
  { \@@_setfontsize:Nnnn \Huge { 36bp } { } { 1 } }
