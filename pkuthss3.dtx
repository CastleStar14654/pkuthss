% \subsubsection{段落 Paragraphing}
%    C\TeX{} 已经进行首行缩进 2 汉字字符的设置。其他设置保留为 \LaTeX{} 标准定义。
%
% \subsubsection{页面设置 Page layout}
% \paragraph{垂直间距 Vertical spacing}
% \begin{macro}[int]{\headheight}
%    页眉从基线算起的高度；总是假设为中易宋体五号字（10.5bp）的基线位置。
%    \begin{macrocode}
\dim_set:Nn \headheight { 10.5bp }
\dim_set:Nn \headheight { \c_@@_ascender_ratio_simsun_tl \headheight }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\headsep}
%    页眉基线到上页边距（3cm）的长度，而页眉顶端要求为 2cm。
%    \begin{macrocode}
\dim_set:Nn \headsep { 3cm - 2cm - \headheight }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\topskip}
%    正文为第一行基线以上高度留出的空隙。由于为固定 20bp 行距，设置为 0.8 倍，即 16bp。
%    \begin{macrocode}
\dim_set:Nn \topskip { 16bp }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\maxdepth, \footskip}
%    页脚基线到正文最下方基线的距离。
%
%    由于 MS Word 的下页边距定义是完整容纳正文，而 \LaTeX{} 定义是正文最下方基线，因此需要
%    进行一些换算。
%
%    这里选择将正文最下方基线定义为底端对齐的（中易宋体）脚注字号（9bp，\cs{footnotesize}）
%    的基线。\cs{maxdepth} 定义为脚注字号的 \cs{strutbox} 的深度，\cs{maxdepth} 处为格
%    式要求的下页边距 2.5cm。
%    \begin{macrocode}
\dim_set:Nn \l_tmpa_dim { 9bp }
\dim_set:Nn \maxdepth { \c_@@_baseline_ratio_simsun_tl \l_tmpa_dim }
\dim_sub:Nn \maxdepth { \c_@@_ascender_ratio_simsun_tl \l_tmpa_dim }
%    \end{macrocode}
%
%    格式要求页脚距边界 1.75cm。MS Word 中，这一距离仍是从文字的底部而非基线计算。这里的计
%    算基准为页脚字体 Times New Roman（五号字，10.5bp）。
%    \begin{macrocode}
\dim_set:Nn \footskip { 2.5cm - 1.75cm }
\dim_set:Nn \l_tmpa_dim { 10.5bp }
\dim_sub:Nn \footskip { \c_@@_baseline_ratio_times_tl \l_tmpa_dim }
\dim_add:Nn \footskip { \c_@@_ascender_ratio_times_tl \l_tmpa_dim + \maxdepth }
%    \end{macrocode}
%
%    如有需要，复刻 Word 添加的底部间距。
%    \begin{macrocode}
\bool_if:NT \l_@@_space_below_footer_bool
  { \dim_sub:Nn \footskip { 8bp } }
%    \end{macrocode}
% \end{macro}
%
% \paragraph{正文尺寸 The dimension of text}
% \begin{macro}[int]{\textwidth}
%    左右页边距 2.6cm。
%    \begin{macrocode}
\dim_set:Nn \l_tmpa_dim { 2.6cm }
\dim_set:Nn \textwidth  { \paperwidth - 2 \l_tmpa_dim }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\textheight}
%    上下页边距 3.0cm 与 2.5cm。还需减去 \cs{maxdepth}。
%    \begin{macrocode}
\dim_set:Nn \l_tmpa_dim { 3.0cm + 2.5cm }
\dim_set:Nn \textheight  { \paperheight - \l_tmpa_dim - \maxdepth }
%    \end{macrocode}
% \end{macro}
%
% \paragraph{边距 Margins}
% \begin{macro}[int]{\oddsidemargin, \evensidemargin}
%   左右页边距 2.6cm。\LaTeX{} 的边距计算起点为 1in。
%    \begin{macrocode}
\dim_set:Nn    \oddsidemargin { 2.6cm - 1in }
\dim_set_eq:NN \evensidemargin \oddsidemargin
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\topmargin}
%    页眉距顶端 2.0cm，而 \cs{topmargin} 为 1in 处到页眉顶端的距离。
%    \begin{macrocode}
\dim_set:Nn \topmargin { 2.0cm - 1in }
%    \end{macrocode}
% \end{macro}
%
% \paragraph{脚注 Footnotes}
% \begin{macro}[int]{\footnotesep}
%    总是使用中易宋体 \cs{footnotesize}（9bp）在基线之上的高度。
%    \begin{macrocode}
\dim_set:Nn \l_tmpa_dim  { 9bp }
\dim_set:Nn \footnotesep { \c_@@_ascender_ratio_simsun_tl \l_tmpa_dim }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\footins}
%    \verb|\skip\footins| 设置为 11bp 的 Times New Roman 的无网格单倍行距，并可无限伸
%    长。
%    \begin{macrocode}
\dim_set:Nn \l_tmpa_dim  { 11bp }
\dim_set:Nn { \skip\footins }
  { \c_@@_baseline_ratio_times_tl \l_tmpa_dim plus 1fil }
%    \end{macrocode}
% \end{macro}
%
% \paragraph{浮动体位置参数 Float placement parameters}
% \begin{macro}[int]{\floatsep, \textfloatsep, \intextsep, \@fpsep}
%    浮动体竖直间距统一设置为 12bp。
%    \begin{macrocode}
\dim_set:Nn \floatsep     { 12bp plus 2bp minus 2bp }
\dim_set:Nn \textfloatsep { 12bp plus 2bp minus 2bp }
\dim_set:Nn \intextsep    { 12bp plus 2bp minus 2bp }
\dim_set:Nn \@fpsep       { 12bp plus 2fil}
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{页面样式 Page styles}
%    页面样式会定义页眉与页脚。
%
% \begin{macro}[int]{pkuthss-thesis-type, pkuthss-chapter}
%    使用新的标记机制，定义本文档类的标记类型。
%    \begin{macrocode}
\mark_new_class:n { pkuthss-thesis-type }
\mark_new_class:n { pkuthss-chapter }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\c_@@_header_rule_dim, \@@_boxed_header:n}
%    定义生成带下方横线线的页眉的函数 \cs{@@_boxed_header:n}。横线长度为文字宽度加上 3bp，
%    存于 \cs{l_@@_header_rule_dim} 中；横线与文字底端间距 1bp。文字行距按照中易宋体计算，
%    以达到全局统一的效果。
%    \begin{macrocode}
\dim_const:Nn \c_@@_header_rule_dim { \textwidth + 3bp }
\cs_new:Nn \@@_boxed_header:n
  {
    \tex_hss:D
    \vbox_top:n
      {
        \@@_set_cjk_baseline:
        \normalfont \@@_header_footer_size:
        \hbox_to_wd:nn { \c_@@_header_rule_dim }
          { \strut \tex_hss:D #1 \tex_hss:D }
        \skip_vertical:n { 1bp }
        \tex_hrule:D height 0.75bp width \c_@@_header_rule_dim depth 0bp
      }
    \tex_hss:D
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\ps@pkuthss}
%    格式要求的页眉页脚样式。
%    \begin{macrocode}
\cs_new:cpn { ps@pkuthss }
  {
    \tl_set:cn { @oddfoot }
      {
        \normalfont \@@_header_footer_size:
        \tex_hfil:D \thepage \tex_hfil:D
      }
    \tl_set_eq:cc { @evenfoot } { @oddfoot }
    \tl_set:cn { @evenhead }
      {
        \@@_boxed_header:n
          { \mark_use_last:nn { page } { pkuthss-thesis-type } }
      }
    \tl_set:cn { @oddhead }
      {
        \@@_boxed_header:n
          { \mark_use_last:nn { page } { pkuthss-chapter } }
      }
    \cs_set:cpn { @mkboth } ##1##2
      { \mark_insert:nn { pkuthss-chapter } {##2} }
    \cs_set:Npn \chaptermark ##1
      {
        \mark_insert:nn { pkuthss-chapter }
          {
            \CTEXifname
              { \CTEXthechapter \skip_horizontal:n { 1\ccwd } }
              { }
            ##1
          }
      }
    \cs_set_eq:NN \sectionmark \use_none:n
  }
%    \end{macrocode}
% \end{macro}
%
% \subsection{文档部件 Document markup}
% \subsubsection{章节 Chapters and sections}
% \begin{macro}{\chapter}
%    \TeX{} 中的竖直间距是相对于基线间距 \cs{baselineskip} 添加的，而格式要求是按照 Word
%    语境定义，指相对于最紧间距外额外添加的间距，因此都需要重新计算。
%
%    章标题前的空白要求为 24bp。间距从 \cs{topskip} 处开始计算，并需减去章节名字号的行距。
%    \begin{macrocode}
\LARGE
\dim_gset:Nn \l_tmpa_dim { 24bp + \box_ht:N \strutbox }
\dim_gsub:Nn \l_tmpa_dim { \topskip + \baselineskip }
\dim_gset:Nn \l_tmpb_dim { 18bp + \box_dp:N \strutbox }
\normalsize
\dim_gadd:Nn \l_tmpb_dim { \box_ht:N \strutbox }
\dim_gsub:Nn \l_tmpb_dim { \baselineskip }
%    \end{macrocode}
%    由于 C\TeX{} 内部将 beforeskip 与 afterskip 存储为 token list，这里需要将输入值
%    展开。
%    \begin{macrocode}
\exp_args:Ne \ctex_set:n
  {
    chapter =
      {
        beforeskip = \dim_use:N \l_tmpa_dim,
        afterskip  = \dim_use:N \l_tmpb_dim
      }
  }
%    \end{macrocode}
%    页面及字体样式设置。
%    \begin{macrocode}
\ctex_set:n
  {
    chapter =
      {
        pagestyle = pkuthss,
        format    = \LARGE\centering,
        aftername = \skip_horizontal:n { 1\ccwd }
      },
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\section, \subsection, \subsubsection}
%    由于其他各级标题的行距都与正文相同，因此设置都比较简单。
%    \begin{macrocode}
    section =
      {
        beforeskip = 24bp,
        afterskip  = 6bp,
        format     = \Large,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
    subsection =
      {
        beforeskip = 12bp,
        afterskip  = 6bp,
        format     = \large,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
    subsubsection =
      {
        beforeskip = 12bp,
        afterskip  = 6bp,
        format     = \normalsize,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\paragraph, \subparagraph}
%    更深一级的标题没有格式要求，仿照 \cs{subsubsection} 进行了设置。
%    \begin{macrocode}
    paragraph =
      {
        beforeskip = 12bp,
        afterskip  = 1\ccwd,
        format     = \normalsize,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
    subparagraph =
      {
        beforeskip = 6bp,
        afterskip  = 1\ccwd,
        format     = \normalsize,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
%    \end{macrocode}
% \end{macro}
%
%    章节编号至 \cs{subsubsection}。
%    \begin{macrocode}
    secnumdepth = 3
  }
%    \end{macrocode}
%
% \subsection{本地化 Localization}
%    大多数本地化通过 \pkg{babel} 自动完成。
%
% \subsubsection{繁体中文 Traditional Chinese}
%    \begin{macrocode}
\bool_if:NT \l_@@_traditional_chinese_bool
  {
    \setlocalecaption { chinese } { ref }        { 參考文獻 }
    \setlocalecaption { chinese } { bib }        { 參考文獻 }
    \setlocalecaption { chinese } { appendix }   { 附錄 }
    \setlocalecaption { chinese } { contents }   { 目錄 }
    \setlocalecaption { chinese } { listfigure } { 插圖 }
    \setlocalecaption { chinese } { figure }     { 圖 }
    \setlocalecaption { chinese } { proof }      { 證明 }
  }
%    \end{macrocode}
%
% \subsubsection{朝鲜/韩文 Korean}
%    需要保留谚文之间的空格。
%    \begin{macrocode}
\str_if_eq:VnF \l__pkuthss_main_language_tl { korean }
  { \AtBeginDocument { \babelprovide [ import ] { korean } } }
\AtBeginDocument
  {
    \addto \extraskorean   { \ctexset { space = true } }
    \addto \noextraskorean { \ctexset { space = auto } }
  }
%    \end{macrocode}
%
% \subsubsection{日韩字体与 CJK 行距 Japanese and Korean fonts and CJK line spacing}
%    字体暂未配置。
%    \begin{macrocode}
\str_if_eq:VnF \l__pkuthss_main_language_tl { japanese }
  { \AtBeginDocument { \babelprovide { japanese } } }
\AtBeginDocument
  {
    \addto \extraschinese    { \@@_set_cjk_baseline: }
    \addto \noextraschinese  { \@@_set_latin_baseline: }
    \addto \extrasjapanese   { \@@_set_cjk_baseline: }
    \addto \noextrasjapanese { \@@_set_latin_baseline: }
    \addto \extraskorean     { \@@_set_cjk_baseline: }
    \addto \noextraskorean   { \@@_set_latin_baseline: }
  }
%    \end{macrocode}
%
% \subsubsection{本地化章节编号 Localization of chapter numberings}
%    需要等到 \pkg{babel} 加载中文后再进行修改，因此使用 \cs{AtBeginDocument}。
%    \begin{macrocode}
\bool_if:NT \l_@@_chapter_localization_bool
  {
    \AtBeginDocument
      {
        \cs_set_eq:NN \bbl@chapterfmt@chinese  \CTEXthechapter
        \cs_set_eq:NN \bbl@chapterfmt@japanese \CTEXthechapter
        \cs_set_eq:NN \CTEXthechapter          \bbl@chfmt
        \cs_set:Npn \CTEX@chaptername
          {
            {
              \CTEX@chapter@nameformat { \CTEXthechapter }
            }
          }
      }
  }
%    \end{macrocode}
