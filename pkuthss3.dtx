%
% \subsubsection{文档类加载时选项 Class loading-time options}
% \begin{macro}{fontset, use-noto}
%    如果用户希望使用 C\TeX{} 的字体配置或自行配置字体，则需指定本选项的值。
%
%    如果用户希望宋、黑体使用思源（Noto）系列，则需指定 \verb|use-noto| 选项。
%    \begin{macrocode}
    fontset .code:n =
      {
        \bool_set_eq:NN \l_@@_fontset_use_ctex_bool \c_true_bool
        \PassOptionsToClass { \CurrentOption } { ctexbook }
      },
    fontset .value_required:n = true,
    fontset .usage:n          = load,
    use-noto .bool_set:N = \l_@@_fontset_use_noto_bool,
    use-noto .initial:n  = false,
    use-noto .default:n  = true,
    use-noto .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}
%   {
%     language, \l_@@_main_language_tl,
%     traditional-chinese, \l_@@_traditional_chinese_bool,
%     english-variant, \l_@@_english_variant_tl
%   }
%    设置论文正文的\textbf{主要}语言，会据此导入 \pkg{babel} 并影响“目录”“参考文献”等章节
%    标题的本地化，影响西文单词的断字，还会影响无文档网格时“单倍行距”按照中易宋体还是 Times
%    New Roman 设置。
%
%    北大似乎只允许中英日韩德俄法西八种语言的学位论文，因此只允许选择这些语言。中日韩语会按照
%    中易宋体设置无网格单倍行距，其他语言按照 Times New Roman。
%
%    如果需要章节序号“第一章”等不按照正文语言本地化，请更改 chapter-localization 选项。
%
%    默认值为 chinese。中文的简体繁体需另行通过 traditional-chinese 选项设置。
%
%    英文变体通过 english-variant 指定。
%
%    这里将输入选项保存为 token list，因为众多 \pkg{babel} 的实现使用了 \cs{ifx} 进行
%    语言判断，而存为 str 会把 catagory code 全部转成 12，导致 \cs{ifx} 失败。
%    \begin{macrocode}
    language .choices:nn =
      {
        chinese, english, japanese, korean,
        german,  ngerman, russian,  french, spanish
      }
      {
        \tl_set_eq:NN \l_@@_main_language_tl \l_keys_choice_tl
      },
    language .initial:n = chinese,
    language .usage:n   = load,
    traditional-chinese .bool_set:N = \l_@@_traditional_chinese_bool,
    traditional-chinese .initial:n  = false,
    traditional-chinese .default:n  = true,
    traditional-chinese .usage:n    = load,
    english-variant .choices:nn =
      { american, australian, british, canadian, newzealand }
      {
        \tl_set_eq:NN \l_@@_english_variant_tl \l_keys_choice_tl
      },
    english-variant .initial:n  = american,
    english-variant .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{chapter-localization, \l_@@_chapter_localization_bool}
%    控制是否将章节序号（“第一章”等）按照 \verb|language| 进行本地化。
%    \begin{macrocode}
    chapter-localization .bool_set:N = \l_@@_chapter_localization_bool,
    chapter-localization .initial:n  = true,
    chapter-localization .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{space-below-footer, \l_@@_space_below_footer_bool}
%    是否模拟 MS Word 默认在页脚文字段后添加 8bp 间距的行为。
%    \begin{macrocode}
    space-below-footer .bool_set:N = \l_@@_space_below_footer_bool,
    space-below-footer .initial:n  = false,
    space-below-footer .default:n  = true,
    space-below-footer .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{文档类一般选项 Class general options}
% \begin{macro}{thesis-type, \l_@@_thesis_type_str}
%    论文类型。
%    \begin{macrocode}
    thesis-type .choices:nn =
      { bachelor, master, doctor, postdoc }
      {
        \str_set:NV \l_@@_thesis_type_str \l_keys_choice_tl
      },
    thesis-type .initial:n = doctor,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{word-grid, \l_@@_word_grid_bool, word-grid-size}
%    是否启用类似 MS Word 文档网格的行为，以及若启用，以 bp 为单位给出网格间距的值。
%    \begin{macrocode}
    word-grid      .bool_set:N = \l_@@_word_grid_bool,
    word-grid      .initial:n  = true,
    word-grid-size .code:n     =
      {
        \fp_set:Nn \l_tmpa_fp {#1}
        \dim_set:Nn \l_@@_word_grid_size_dim
          { \fp_eval:n \l_tmpa_fp bp }
      },
    word-grid-size .initial:n = 15.6,
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{其他未知选项 Other unknown options}
%    使用 \cs[no-index]{IfClassLoadedTF} 判定该未知选项是否是在加载本文档类时给出的。若
%    为加载时选项，则传给上游 \cls{ctexbook}，否则给出警告。
%    \begin{macrocode}
    unknown .code:n =
      {
        \IfClassLoadedTF { ctexbook }
          { \msg_warning:nn { pkuthss } { option-invalid } }
          { \PassOptionsToClass { \CurrentOption } { ctexbook } }
      },
%    \end{macrocode}
%
% \subsubsection{^^A
%   从标准文档类或 C\TeX{} 中去除的选项 Options removed from standard or C\TeX\
%   classes}
%    以下两个 C\TeX{} 选项 \pkg{pkuthss} 已经给定值，用户另行指定值无效，因此给出警告。
%    \begin{macrocode}
    zihao      .code:n = \msg_warning:nn { pkuthss } { option-preset },
    linespread .code:n = \msg_warning:nn { pkuthss } { option-preset },
%    \end{macrocode}
%
%    \begin{macrocode}
  }
%    \end{macrocode}
%
%    以下标准文档类选项由于格式要求，对 \pkg{pkuthss} 无意义，设置为无效。
%    \begin{macrocode}
\clist_map_inline:nn
  {
    a5paper , b5paper , letterpaper , legalpaper , executivepaper ,
    landscape ,
    10pt , 11pt , 12pt ,
    twoside , oneside ,
    titlepage , notitlepage ,
    onecolumn , twocolumn ,
    leqno ,
    openbib ,
%    \end{macrocode}
%    以及 C\TeX{} 的 \cmd[no-index]{scheme} 选项。
%    \begin{macrocode}
    scheme
  }
  {
    \@@_define_option:n
      {
        #1 .code:n  = \OptionNotUsed,
        #1 .usage:n = load,
      }
  }
%    \end{macrocode}
%
%
% \subsection{加载上游文档类与宏包 Loading upstream class and packages}
%    处理选项后加载 \cls{ctexbook}。
%    \begin{macrocode}
\ProcessKeyOptions [ pkuthss ]
\LoadClass [ a4paper , zihao = -4 , linespread = 1.0 ] { ctexbook }
%    \end{macrocode}
%
%    \begin{macrocode}
\RequirePackage { unicode-math }
%    \end{macrocode}
%
% \subsubsection{\pkg{babel} 语言设置 \pkg{babel} settings}
%
%    总是需要导入英文。
%    \begin{macrocode}
\PassOptionsToPackage { \l_@@_english_variant_tl } { babel }
%    \end{macrocode}
%    主要语言不是英文时，还需导入主要语言。
%    \begin{macrocode}
\str_if_eq:VnF \l_@@_main_language_tl { english }
  {
    \PassOptionsToPackage { \l_@@_main_language_tl } { babel }
  }
%    \end{macrocode}
%    主要语言是中文或朝鲜/韩文时，需要将主要语言以“modern”形式导入。
%    \begin{macrocode}
\str_case:VnT \l_@@_main_language_tl
  {
    { chinese } { }
    { korean }  { }
  }
  { \PassOptionsToPackage { provide = * } { babel } }
%    \end{macrocode}
%    导入 \pkg{babel}。
%    \begin{macrocode}
\RequirePackage { babel }
%    \end{macrocode}
%    主要语言非中文或英文时，需要将中文作为次要语言导入。
%    \begin{macrocode}
\str_case:VnF \l_@@_main_language_tl
  {
    { chinese } { }
    { english } { }
  }
  { \AtBeginDocument { \babelprovide [ import ] { chinese } } }
%    \end{macrocode}
%
% \subsection{用户设置接口及元数据 User settings API and metadata}
% \begin{macro}{\pkusetup,\pkumetadata}
%    简单设置为别名。设置为只可在导言区使用。
%    \begin{macrocode}
\NewDocumentCommand \pkusetup { m }
  { \@@_set_option:n   {#1} }
\NewDocumentCommand \pkumetadata { m }
  { \@@_set_metadata:n {#1} }
\@onlypreamble \pkusetup
\@onlypreamble \pkumetadata
%    \end{macrocode}
% \end{macro}
%
% \subsection{文档设置 Document layout}
% \subsubsection{字体 Font families}
%    警告信息。
%    \begin{macrocode}
\msg_new:nnn { pkuthss } { noto-not-found }
  {
    You~set~`use-noto'~option,~but~Noto~CJK~font~is~not~found.\\
    Use~Fandol~instead.
  }
%    \end{macrocode}
%    如果用户没有指定 \verb|fontset| 选项，则进行自动配置。C\TeX{} 内部会将字体设置的参数
%    完全展开，因此不用做相关处理。
%    \begin{macrocode}
\bool_if:NF \l_@@_fontset_use_ctex_bool
  {
%    \end{macrocode}
% \paragraph{衬线字体}
%    直立体选用宋体，斜体选用仿宋。
%
% \subparagraph{仿宋}
%    按照 Windows、Mac、Fandol 的顺序设置。仿宋也设置为等宽字体
%    \begin{macrocode}
    \fontspec_font_if_exist:nTF { FangSong }
      { \tl_set:Nn \l_@@_tmpa_tl { FangSong } }
      {
        \fontspec_font_if_exist:nTF { STFangsong }
          { \tl_set:Nn \l_@@_tmpa_tl { STFangSong } }
          { \tl_set:Nn \l_@@_tmpa_tl { FandolFang-Regular.otf } }
      }
    \setCJKfamilyfont { zhfs } { \l_@@_tmpa_tl } [ AutoFakeBold = 2 ]
    \setCJKmonofont   { \l_@@_tmpa_tl } [ AutoFakeBold = 2 ]
    \tl_set:Ne \l_@@_tmpa_tl
      {
        ItalicFont         = \l_@@_tmpa_tl,
        BoldItalicFont     = \l_@@_tmpa_tl,
        BoldItalicFeatures = { FakeBold = 2 }
      }
%    \end{macrocode}
% \subparagraph{宋体}
%    先默认设置成 Fandol，后按照 Windows、Mac、Noto 的优先级顺序覆盖；如果用户选择了
%    \verb|use-noto|，则 Noto 优先级最高。
%
%    Fandol 自带粗宋体。
%    \begin{macrocode}
    \tl_set:Nn  \l_@@_tmpb_tl { FandolSong-Regular.otf }
    \tl_clear:N \l_@@_tmpc_tl
%    \end{macrocode}
%    临时变量 \cs{l_@@_tmpa_bool} 保存 Noto CJK 系列字体是否存在。
%    \begin{macrocode}
    \bool_set_eq:NN \l_@@_tmpa_bool \c_true_bool
    \fontspec_font_if_exist:nF { Noto~Serif~CJK~SC }
      {
        \bool_if:NT \l_@@_fontset_use_noto_bool
          {
%    \end{macrocode}
%    有可能用户使用的是非 Linux 系统下的 MiK\TeX{}，通过给出字体文件名促使自动安装
%    \pkg{notocjksc} 宏包。
%    \begin{macrocode}
            \fontspec_font_if_exist:nF { NotoSerifCJKsc-Regular.otf }
              {
                msg_warning:nn { pkuthss } { noto-not-found }
                \bool_set_eq:NN \l_@@_tmpa_bool \c_false_bool
              }
          }
      }
    \bool_if:NT \l_@@_tmpa_bool
      {
        \tl_set:Nn \l_@@_tmpb_tl { Noto~Serif~CJK~SC~Light }
        \tl_set:Nn \l_@@_tmpc_tl { BoldFont = Noto~Serif~CJK~SC~SemiBold }
      }
    \bool_if:NF \l_@@_fontset_use_noto_bool
      {
        \fontspec_font_if_exist:nTF { SimSun }
          {
            \tl_set:Nn \l_@@_tmpb_tl { SimSun }
            \tl_set:Nn \l_@@_tmpc_tl { AutoFakeBold = 2 }
          }
          {
            \fontspec_font_if_exist:nT { Songti~SC }
              {
                \tl_set:Nn  \l_@@_tmpb_tl { Songti~SC }
                \tl_clear:N \l_@@_tmpc_tl
              }
          }
      }
    \setCJKfamilyfont { zhsong }
      { \l_@@_tmpb_tl } [ \l_@@_tmpc_tl ]
    \setCJKmainfont   { \l_@@_tmpb_tl }
      [ \l_@@_tmpc_tl , \l_@@_tmpa_tl ]
%    \end{macrocode}
% \paragraph{无衬线字体}
%    直立体选用黑体，斜体选用楷体。
%
% \subparagraph{楷体}
%    类似仿宋的设置顺序，按照 Windows、Mac、文鼎 UKai、文鼎简中楷的顺序设置。作为最后备份，
%    文鼎简中楷使用文件名给定。
%
%    Mac 下的系统楷体有自带粗体字形，不需要设置伪粗体。
%    \begin{macrocode}
    \tl_set:Nn \l_@@_tmpb_tl { AutoFakeBold = 2 }
    \fontspec_font_if_exist:nTF { KaiTi }
      { \tl_set:Nn \l_@@_tmpa_tl { KaiTi } }
      {
        \fontspec_font_if_exist:nTF { Kaiti~SC }
          {
            \tl_set:Nn \l_@@_tmpa_tl { Kaiti~SC }
            \tl_clear:N \l_@@_tmpb_tl
          }
          {
            \fontspec_font_if_exist:nTF { AR~PL~UKai~CN }
              { \tl_set:Nn \l_@@_tmpa_tl { AR~PL~UKai~CN } }
              { \tl_set:Nn \l_@@_tmpa_tl { gkai00mp.ttf } }
          }
      }
    \setCJKfamilyfont { zhkai }
      { \l_@@_tmpa_tl } [ \l_@@_tmpb_tl ]
    \tl_if_empty:NTF \l_@@_tmpb_tl
      { \tl_set:Ne \l_@@_tmpa_tl { ItalicFont = \l_@@_tmpa_tl } }
      {
        \tl_set:Ne \l_@@_tmpa_tl
          {
            ItalicFont         = \l_@@_tmpa_tl,
            BoldItalicFont     = \l_@@_tmpa_tl,
            BoldItalicFeatures = { FakeBold = 2 }
          }
      }
%    \end{macrocode}
% \subparagraph{黑体}
%    类似宋体，先默认设置成 Fandol，后按照 Windows、Mac、Noto 的优先级顺序覆盖。
%
%    Fandol 自带粗黑体。
%    \begin{macrocode}
    \tl_set:Nn  \l_@@_tmpb_tl { FandolHei-Regular.otf }
    \tl_clear:N \l_@@_tmpc_tl
    \bool_if:NT \l_@@_tmpa_bool
      {
        \tl_set:Nn \l_@@_tmpb_tl { Noto~Sans~CJK~SC~DemiLight }
        \tl_set:Nn \l_@@_tmpc_tl { BoldFont = Noto~Sans~CJK~SC~Medium }
      }
    \bool_if:NF \l_@@_fontset_use_noto_bool
      {
        \fontspec_font_if_exist:nTF { SimHei }
          {
            \tl_set:Nn \l_@@_tmpb_tl { SimHei }
            \tl_set:Nn \l_@@_tmpc_tl { AutoFakeBold = 2 }
          }
          {
            \fontspec_font_if_exist:nT { Heiti~SC~Light }
              {
                \tl_set:Nn \l_@@_tmpb_tl { Heiti~SC~Light }
                \tl_set:Nn \l_@@_tmpc_tl { BoldFont = Heiti~SC~Medium }
              }
          }
      }
    \setCJKfamilyfont { zhhei }
      { \l_@@_tmpb_tl } [ \l_@@_tmpc_tl ]
    \setCJKsansfont   { \l_@@_tmpb_tl }
      [ \l_@@_tmpc_tl , \l_@@_tmpa_tl ]
%    \end{macrocode}
%    最后定义字体命令。
%    \begin{macrocode}
    \NewDocumentCommand \songti   { } { \CJKfamily { zhsong  } }
    \NewDocumentCommand \heiti    { } { \CJKfamily { zhhei   } }
    \NewDocumentCommand \fangsong { } { \CJKfamily { zhfs    } }
    \NewDocumentCommand \kaishu   { } { \CJKfamily { zhkai   } }
  }
