%
% \paragraph{学位论文封面实现 Thesis titlepage implementation}
% \begin{templateinterfacedecl}{titlepage/thesis}
%    使用内核提供的局域临时变量应该是安全的。
%    \begin{macrocode}
\DeclareTemplateCode { titlepage } { thesis } { 0 }
  {
    thesis-name        = \l_tmpa_tl,
    before-logo-skip   = \l_tmpa_skip,
    after-title-skip   = \l_tmpb_skip,
    after-meta-skip    = \l_@@_tmpa_skip,
    after-degree-skip  = \l_@@_tmpb_skip,
    after-date-skip    = \l_@@_tmpc_skip,
    show-english-title = \l_tmpa_bool,
    english-title-size = \l_tmpa_dim,
    show-direction     = \l_tmpb_bool,
    show-degree-type   = \l_@@_tmpa_bool,
  }
  {
    \begin { titlepage }
%    \end{macrocode}
%    尽可能与模板封面一致的参数；将 \cs{lineskip} 设置为 0pt，避免 \LaTeX{} 自动添加间距。
%    \begin{macrocode}
      \selectlanguage { chinese }
      \bool_set_eq:NN \l_@@_word_grid_bool \c_true_bool
      \tl_set:Nn \arraystretch { 1 }
      \dim_set:Nn \parindent { 0pt }
      \dim_set:Nn \tabcolsep { 0.19cm }
      \dim_set:Nn \lineskip { 0pt }
      \dim_set:Nn \arrayrulewidth { 0.75bp }
%    \end{macrocode}
% \subparagraph{校徽、校名题字以及论文类型}
%    复原了 Word 会在图片上下添加的 0.2cm 间距。
%    \begin{macrocode}
      \mode_leave_vertical:
      \skip_vertical:n { \l_tmpa_skip - \topskip }
      {
        \centering
        \skip_vertical:n { 0.2cm }
        \@@_pku_logo:
        \skip_vertical:n { 0.2cm }
        {
          \Huge \sffamily
          \strut \l_tmpa_tl
        }
        \skip_vertical:n { 19.5bp }
      }
%    \end{macrocode}
% \subparagraph{论文题目}
%    表格左缩进参照 docx 格式的行为；doc 格式会少缩进 0.19cm，暂不实现。
%    单元格中的内容设置为居中可换行，宽度为减去两侧 \cs{tabcolsep} 后的值。
%    \begin{macrocode}
      {
        \huge
        \skip_horizontal:n { 1.25cm }
        \dim_set:Nn \l_tmpb_dim { \box_dp:N \strutbox }
        \begin { tabular } [ b ]
          {
            > { \centering\arraybackslash \@@_timu_size: }
            b { 2.37cm }
            > { \centering\arraybackslash \sffamily\bfseries }
            b { 9.78cm }
          }
%    \end{macrocode}
%    “题目”二字靠单元格底端对齐，而非默认的与右侧文字按基线对齐。
%    \begin{macrocode}
          \mode_leave_vertical:
          \box_move_up:nn { \box_dp:N \strutbox - \l_tmpb_dim }
            {
              \hbox_to_wd:nn { 3\ccwd }
                {
                  \prop_item:Nn \l_@@_metadata_label_prop
                    { title_chinese }
                  ：
                }
            }
          &
%    \end{macrocode}
%    仅有中文题目时，使用 \cs{multirow} 自动处理换行。\cs{multirow} 内容为竖直居中，因此
%    内部嵌套高度为两行的 \cs{parbox}。
%    \begin{macrocode}
          \bool_if:NTF \l_tmpa_bool
            { \l_@@_title_chinese_tl }
            {
              \dim_set:Nn \l_tmpb_dim { 2 \baselineskip }
              \dim_add:Nn \l_tmpb_dim { \arrayrulewidth }
              \multirow { 2 } { * }
                {
                  \parbox [t] [ \l_tmpb_dim ] [t] { \linewidth }
                    { \centering \l_@@_title_chinese_tl }
                }
            }
          \\ \@@_meta_cline:
%    \end{macrocode}
%    需要英文题目时，提供用户自定义字号的配置。
%    \begin{macrocode}
          &
          \bool_if:NT \l_tmpa_bool
            {
              \@@_setfontsize:Nnnn \l_tmpa_dim
                { \dim_use:N \l_tmpa_dim } { } { 1 }
              \l_@@_title_english_tl
            }
          \\ \@@_meta_cline:
        \end { tabular }
      }
      \skip_vertical:N \l_tmpb_skip
%    \end{macrocode}
% \subparagraph{信息表}
%    \begin{macrocode}
      {
        \LARGE
        \skip_horizontal:n { 1.75cm }
        \begin { tabular } [ t ]
          {
            > {\raggedleft\arraybackslash\sffamily\@@_meta_class_size:}
            p {2.81cm}
            > {\centering\arraybackslash \fangsong}
            p {7.25cm}
          }
          \clist_map_inline:nn
            { name_chinese , student_id , school , major_chinese }
            {
              \@@_meta_label:n
                { \prop_item:Nn \l_@@_metadata_label_prop {##1} }
              & \tl_use:c { l_@@_ ##1 _tl }
              \\ \@@_meta_cline:
            }
          \bool_if:NT \l_tmpb_bool
            {
              \@@_meta_label:n
                {
                  \prop_item:Nn \l_@@_metadata_label_prop
                    { direction }
                }
              & \l_@@_direction_tl
              \\ \@@_meta_cline:
            }
          \@@_meta_label:n
            {
              \prop_item:Nn \l_@@_metadata_label_prop
                { mentor_chinese }
            } &
          \clist_use:Nn \l_@@_mentor_chinese_clist
            { \\ \@@_meta_cline: & }
          \\ \@@_meta_cline:
        \end { tabular }
        \skip_vertical:N \l_@@_tmpa_skip
        {
          \centering
          \bool_if:NT \l_@@_tmpa_bool
            {
              \strut { \fangsong \@@_typeset_degree_type: }
              \skip_vertical:N \l_@@_tmpb_skip
            }
          \strut \l_@@_date_tl
          \skip_vertical:N \l_@@_tmpc_skip
        }
      }
    \end { titlepage }
  }
%    \end{macrocode}
% \end{templateinterfacedecl}
%
% \paragraph{匿名评阅封面实现 Anonymous reviewing titlepage implementation }
% \begin{templateinterfacedecl}{titlepage/anonymous}
%    盲评封面比较简单，设置好标题较长时更美观的悬挂缩进即可。
%    \begin{macrocode}
\DeclareTemplateCode { titlepage } { anonymous } { 0 }
  {
    thesis-name = \l_tmpa_tl
  }
  {
    \begin { titlepage }
      \selectlanguage { chinese }
      \raggedright\LARGE\fangsong
      \bool_set_eq:NN \l_@@_word_grid_bool \c_true_bool
      \dim_set:Nn \parindent { -5em }
      \dim_set:Nn \leftskip  {  5em }
      \mode_leave_vertical:
      \tex_vfill:D
      {
        \centering
        { \Huge\bfseries\sffamily \strut \l_tmpa_tl }
        \tex_par:D
        {
          \strut \zihao{-2}\fangsong
          \prop_item:Nn \l_@@_metadata_label_prop { anonymous_label }
        }
        \skip_vertical:n { 0pt plus 0.5fill }
      }
      \clist_map_inline:nn { chinese , english }
        {
          \prop_item:Nn \l_@@_metadata_label_prop { ##1 _anonymous }
          \prop_item:Nn \l_@@_metadata_label_prop { title_chinese }
          ：
          \tl_use:c { l_@@_title_ ##1 _tl }
          \tex_par:D
        }
      \skip_vertical:n { 31.2bp }
      \clist_map_inline:nn { discipline , major }
        {
          \prop_item:Nn \l_@@_metadata_label_prop { anonymous_ ##1 }
          ：
          \tl_use:c { l_@@_ ##1 _chinese_tl }
          \tex_par:D
        }
