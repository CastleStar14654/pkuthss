          { \tl_set:Nn \l_@@_tmpa_tl { gkai00mp.ttf } }
      }
    \setCJKfamilyfont { zhkai }
      { \l_@@_tmpa_tl } [ \l_@@_tmpb_tl ]
    \tl_if_empty:NTF \l_@@_tmpb_tl
      { \tl_set:Ne \l_@@_tmpa_tl { ItalicFont = \l_@@_tmpa_tl } }
      {
        \tl_set:Ne \l_@@_tmpa_tl
          {
            ItalicFont         = \l_@@_tmpa_tl,
            BoldItalicFont     = \l_@@_tmpa_tl,
            BoldItalicFeatures = { FakeBold = 2 }
          }
      }
