        \tl_set:Nn \l_@@_tmpc_tl { BoldFont = FandolHei-Bold.otf }
        \bool_set_false:N \l_@@_tmpa_bool
        \sys_if_platform_windows:TF
          {
            \fontspec_font_if_exist:nTF { Noto~Sans~SC~DemiLight }
              {
                \tl_set:Nn \l_@@_tmpb_tl { Noto~Sans~SC~DemiLight }
                \tl_set:Nn \l_@@_tmpc_tl
                  { BoldFont = Noto~Sans~SC~Medium }
              }
              { \bool_set_true:N \l_@@_tmpa_bool }
          }
          { \bool_set_true:N \l_@@_tmpa_bool }
        \bool_if:NT \l_@@_tmpa_bool
          {
            \fontspec_font_if_exist:nF { Noto~Sans~CJK~SC~DemiLight }
              {
                \bool_if:NT \l_@@_fontset_use_noto_bool
                  {
                    \fontspec_font_if_exist:nF { NotoSansCJKsc-DemiLight.otf }
                      {
                        msg_warning:nn { pkuthss } { noto-not-found }
                        \bool_set_eq:NN \l_@@_tmpa_bool \c_false_bool
                      }
                  }
              }
            \bool_if:NT \l_@@_tmpa_bool
              {
                \tl_set:Nn \l_@@_tmpb_tl { Noto~Sans~CJK~SC~DemiLight }
                \tl_set:Nn \l_@@_tmpc_tl
                  { BoldFont = Noto~Sans~CJK~SC~Medium }
              }
          }
