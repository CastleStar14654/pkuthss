% \begin{macro}{\@@_header_footer_size:}
%    页眉页脚字号（五号字），不对齐到网格。
%    \begin{macrocode}
\cs_new_protected:Nn \@@_header_footer_size:
  {
    \@@_word_grid_tmp_off:n
      {
