% \subsubsection{章节 Chapters and sections}
% \begin{macro}{\frontmatter}
%    前言部分使用大写罗马数字标号。
%    \begin{macrocode}
\RenewDocumentCommand \frontmatter { }
  {
    \cleardoublepage
    \@mainmatterfalse
    \pagenumbering{Roman}
  }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\chapter}
%    \TeX{} 中的竖直间距是相对于基线间距 \cs{baselineskip} 添加的，而格式要求是按照 Word
%    语境定义，指相对于最紧间距外额外添加的间距，因此都需要重新计算。
%
%    章标题前的空白要求为 24bp。间距从 \cs{topskip} 处开始计算，并需减去章节名字号的行距。
%    \begin{macrocode}
\LARGE
\dim_gset:Nn \l_tmpa_dim { 24bp + \box_ht:N \strutbox }
\dim_gsub:Nn \l_tmpa_dim { \topskip + \baselineskip }
\dim_gset:Nn \l_tmpb_dim { 18bp + \box_dp:N \strutbox }
\normalsize
\dim_gadd:Nn \l_tmpb_dim { \box_ht:N \strutbox }
\dim_gsub:Nn \l_tmpb_dim { \baselineskip }
%    \end{macrocode}
%    由于 C\TeX{} 内部将 beforeskip 与 afterskip 存储为 token list，这里需要将输入值
%    展开。
%    \begin{macrocode}
\exp_args:Ne \ctex_set:n
  {
    chapter =
      {
        beforeskip = \dim_use:N \l_tmpa_dim,
        afterskip  = \dim_use:N \l_tmpb_dim
      }
  }
%    \end{macrocode}
%    页面及字体样式设置。
%    \begin{macrocode}
\ctex_set:n
  {
    chapter =
      {
        pagestyle = pkuthss,
        format    = \LARGE\centering,
        aftername = \skip_horizontal:n { 1\ccwd }
      },
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\section, \subsection, \subsubsection}
%    由于其他各级标题的行距都与正文相同，因此设置都比较简单。
%    \begin{macrocode}
    section =
      {
        beforeskip = 24bp,
        afterskip  = 6bp,
        format     = \Large,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
    subsection =
      {
        beforeskip = 12bp,
        afterskip  = 6bp,
        format     = \large,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
    subsubsection =
      {
        beforeskip = 12bp,
        afterskip  = 6bp,
        format     = \normalsize,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{\paragraph, \subparagraph}
%    更深一级的标题没有格式要求，仿照 \cs{subsubsection} 进行了设置。
%    \begin{macrocode}
    paragraph =
      {
        beforeskip = 12bp,
        afterskip  = 1\ccwd,
        format     = \normalsize,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
    subparagraph =
      {
        beforeskip = 6bp,
        afterskip  = 1\ccwd,
        format     = \normalsize,
        aftername  = \skip_horizontal:n { 1\ccwd }
      },
%    \end{macrocode}
% \end{macro}
%
%    章节编号至 \cs{subsubsection}。
%    \begin{macrocode}
    secnumdepth = 3
  }
%    \end{macrocode}
%
% \begin{macro}[int]{\@schapter}
%    使无编号章生成页眉。
%    \begin{macrocode}
\apptocmd { \@schapter } { \chaptermark {#1} } { } { }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{列表 Lists}
% \paragraph{一般列表参数 General list parameters}
%    列表格式并没有任何规定。本文档类做一些简单设置。
%
% \begin{macro}[int]{\leftmargin, \leftmargini}
%    最外层的列表做悬挂缩进 2 汉字字符，与正文的首行缩进对齐。
%
%    此外，\cs{leftmargini} 还会在文档类结尾被隐式设置成左对齐行间公式的缩进值
%    （\cs{mathindent}）。格式要求也为 2 汉字字符。
%    \begin{macrocode}
\dim_set:Nn    \leftmargini { 2\ccwd }
\dim_set_eq:NN \leftmargin  \leftmargini
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\partopsep, \@listi, \@listI}
%    将列表内部的间距都缩减为普通段落间距 \cs{parskip}。前方留出 8bp 的间距，这样总的行间
%    空白恰为正文情况（20bp${}-{}$12bp）的两倍。若前方分段，则间距再增加 3bp，相当于总共
%    19bp 的空白。
%    \begin{macrocode}
\dim_set:Nn \partopsep { 3bp plus 2bp minus 2bp }
\tl_set:cn { @listi }
  {
    \leftmargin\leftmargini
    \parsep  \parskip
    \topsep  8bp plus 3bp minus 4bp
    \itemsep \parsep
    \listparindent \parindent
  }
\tl_set_eq:cc { @listI } { @listi }
\tl_use:c { @listi }
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}[int]{\@listii, \@listiii, \@listiv, \@listv, \@listvi}
%    列表前的间距逐级减小。
%    \begin{macrocode}
\tl_set:cn { @listii }
  {
    \leftmargin\leftmarginii
    \labelwidth\leftmarginii
    \advance\labelwidth-\labelsep
    \topsep  4bp plus 1.5bp minus 1bp
    \parsep  \parskip
    \itemsep \parsep
    \listparindent \parindent
  }
\tl_set:cn { @listiii }
  {
    \leftmargin\leftmarginiii
    \labelwidth\leftmarginiii
    \advance\labelwidth-\labelsep
    \topsep  2bp plus 1bp minus 1bp
    \parsep  \parskip
    \itemsep \parsep
    \listparindent \parindent
  }
\tl_set:cn { @listiv }
  {
    \leftmargin\leftmarginiv
    \labelwidth\leftmarginiv
    \advance\labelwidth-\labelsep
    \parsep  \parskip
    \itemsep \parsep
    \listparindent \parindent
  }
\tl_set:cn { @listv }
  {
    \leftmargin\leftmarginv
    \labelwidth\leftmarginv
    \advance\labelwidth-\labelsep
    \parsep  \parskip
    \itemsep \parsep
    \listparindent \parindent
  }
\tl_set:cn { @listvi }
  {
    \leftmargin\leftmarginvi
    \labelwidth\leftmarginvi
    \advance\labelwidth-\labelsep
    \parsep  \parskip
    \itemsep \parsep
    \listparindent \parindent
  }
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{摘要 Abstracts}
% \begin{environment}{abstract}
%    通用摘要，摘要名称大写。五个参数依次为语言、摘要章节名、关键词标签、关键词分隔符、关键词
%    列表。前两个参数仅在定义 \env{cabstract} 与 \env{eabstract} 时使用，用户无需使用。
%    \begin{macrocode}
\NewDocumentEnvironment { abstract } { o o m O{,~} m }
  {
    \tl_if_novalue:nF {#1} { \selectlanguage {#1} }
    \tl_if_novalue:nTF {#2}
      { \chapter* { \text_uppercase:n \abstractname } }
      {
        \chapter* {#2}
        \chaptermark { \text_uppercase:n \abstractname }
      }
  }
  {
    \tex_vfill:D
    #3
    \clist_use:nn {#5} {#4}
  }
%    \end{macrocode}
% \end{environment}
%
% \begin{environment}{cabstract}
%    唯一的参数是关键词列表。
%    \begin{macrocode}
\NewDocumentEnvironment { cabstract } { m }
  {
    \begin{abstract} [ chinese ] { 关键词： } [ ， ] {#1}
  }
  {
    \end{abstract}
  }
%    \end{macrocode}
% \end{environment}
%
% \begin{environment}{eabstract}
%    英文摘要在非匿名评阅时需要排版英文的题名以及作者信息。
%    \begin{macrocode}
\NewDocumentEnvironment { eabstract } { m }
  {
    \bool_if:NTF \l_@@_anonymous_bool
      {
        \abstract [ \l_@@_english_variant_tl ]
          { KEY~WORDS:~ } [ ,~ ] {#1}
      }
      {
        \abstract [ \l_@@_english_variant_tl ]
          [ \l_@@_title_english_tl ] { KEY~WORDS:~ } [ ,~ ] {#1}
        {
          \centering
          \tl_use:N \l_@@_name_english_tl \c_space_tl
          ( \l_@@_major_english_tl )
          \tex_par:D
          Supervised~by~
          \clist_use:Nnnn \l_@@_mentor_english_clist
            { ~and~ } { ,~ } { ,~and~ }
          \skip_vertical:n { 8bp }
          { \sffamily \bfseries \text_uppercase:n { \abstractname } }
          \skip_vertical:n { 6bp }
        }
      }
  }
  {
    \endabstract
  }
%    \end{macrocode}
% \end{environment}
%
% \subsubsection{浮动体 Floats}
%    仅定义格式要求的图名/表名样式。在 \S\ref{sssec:page_layout} 已经使浮动体与周围文字
%    间距为 12bp，这里只需设置 caption 与图/表间距为 6bp。
%    \begin{macrocode}
\captionsetup
  {
    labelsep       = quad,
    font           = small,
    skip           = 6bp,
    figureposition = bottom,
    tableposition  = top
  }
