% \subsubsection{文档类加载时选项 Class loading-time options}
% \begin{macro}{fontset, fontset-use-noto, fontset-use-gyre, fontset-required}
%    如果用户希望使用 C\TeX{} 的字体配置或自行配置字体，则需指定本选项的值。
%
%    如果用户希望宋、黑体使用思源（Noto）系列，则需指定 \opt{fontset-use-noto} 选项。
%
%    如果用户希望西文字体使用 TeX Gyre 系列，则需指定 \opt{fontset-use-gyre} 选项。由于
%    TeX Gyre Heros 基于 Helvetica，与 Arial 存在较为显著的区别，还提供了
%    \opt{fontset-use-arial} 选项，无衬线体使用 Arial，衬线和等宽字体使用 TeX Gyre
%    系列。
%
%    默认情况下，根据平台自动配置字体。如果用户希望严格使用中易系列中文字体以及 Times New
%    Roman 和 Arial，则需指定 \opt{fontset-required} 选项。\opt{fontset-required}
%    优先级低于 \opt{fontset-use-noto} 与 \opt{fontset-use-gyre}。
%    \begin{macrocode}
    fontset .code:n =
      {
        \bool_set_eq:NN \l_@@_fontset_use_ctex_bool \c_true_bool
        \PassOptionsToClass { \CurrentOption } { ctexbook }
      },
    fontset .value_required:n = true,
    fontset .usage:n          = load,
    fontset-use-noto .bool_set:N = \l_@@_fontset_use_noto_bool,
    fontset-use-noto .initial:n  = false,
    fontset-use-noto .default:n  = true,
    fontset-use-noto .usage:n    = load,
    fontset-use-gyre .bool_set:N = \l_@@_fontset_use_gyre_bool,
    fontset-use-gyre .initial:n  = false,
    fontset-use-gyre .default:n  = true,
    fontset-use-gyre .usage:n    = load,
    fontset-use-arial .bool_set:N = \l_@@_fontset_use_arial_bool,
    fontset-use-arial .initial:n  = false,
    fontset-use-arial .default:n  = true,
    fontset-use-arial .usage:n    = load,
    fontset-required .bool_set:N = \l_@@_fontset_required_bool,
    fontset-required .initial:n  = false,
    fontset-required .default:n  = true,
    fontset-required .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}
%   {
%     language, \l_@@_main_language_tl,
%     traditional-chinese, \l_@@_traditional_chinese_bool,
%     english-variant, \l_@@_english_variant_tl
%   }
%    设置论文正文的\textbf{主要}语言，会据此导入 \pkg{babel} 并影响“目录”“参考文献”等章节
%    标题的本地化，影响西文单词的断字，还会影响无文档网格时“单倍行距”按照中易宋体还是 Times
%    New Roman 设置。
%
%    北大似乎只允许中英日韩德俄法西八种语言的学位论文，因此只允许选择这些语言。中日韩语会按照
%    中易宋体设置无网格单倍行距，其他语言按照 Times New Roman。
%
%    如果需要章节序号“第一章”等不按照正文语言本地化，请更改 chapter-localization 选项。
%
%    默认值为 chinese。中文的简体繁体需另行通过 traditional-chinese 选项设置。
%
%    英文变体通过 english-variant 指定。
%
%    这里将输入选项保存为 token list，因为众多 \pkg{babel} 的实现使用了 \cs{ifx} 进行
%    语言判断，而存为 str 会把 catagory code 全部转成 12，导致 \cs{ifx} 失败。
%    \begin{macrocode}
    language .choices:nn =
      {
        chinese, english, japanese, korean,
        german,  ngerman, russian,  french, spanish
      }
      {
        \tl_set_eq:NN \l_@@_main_language_tl \l_keys_choice_tl
      },
    language .initial:n = chinese,
    language .usage:n   = load,
    traditional-chinese .bool_set:N = \l_@@_traditional_chinese_bool,
    traditional-chinese .initial:n  = false,
    traditional-chinese .default:n  = true,
    traditional-chinese .usage:n    = load,
    english-variant .choices:nn =
      { american, australian, british, canadian, newzealand }
      {
        \tl_set_eq:NN \l_@@_english_variant_tl \l_keys_choice_tl
      },
    english-variant .initial:n  = american,
    english-variant .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{chapter-localization, \l_@@_chapter_localization_bool}
%    控制是否将章节序号（“第一章”等）按照 \opt{language} 进行本地化。
%    \begin{macrocode}
    chapter-localization .bool_set:N = \l_@@_chapter_localization_bool,
    chapter-localization .initial:n  = true,
    chapter-localization .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{footmisc}
%    \begin{macrocode}
    footmisc .clist_set:N      = \l_@@_footmisc_option_clist,
    footmisc .initial:n        = { perpage, bottom, belowfloats },
    footmisc .value_required:n = true,
    footmisc .usage:n          = load,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{space-below-footer, \l_@@_space_below_footer_bool}
%    是否模拟 MS Word 默认在页脚文字段后添加 8bp 间距的行为。
%    \begin{macrocode}
    space-below-footer .bool_set:N = \l_@@_space_below_footer_bool,
    space-below-footer .initial:n  = false,
    space-below-footer .default:n  = true,
    space-below-footer .usage:n    = load,
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{文档类一般选项 Class general options}
% \begin{macro}{thesis-type, \l_@@_thesis_type_str}
%    论文类型。
%    \begin{macrocode}
    thesis-type .choices:nn =
      { bachelor, master, doctor, postdoc }
      {
        \str_set:NV \l_@@_thesis_type_str \l_keys_choice_tl
      },
    thesis-type .initial:n = doctor,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{anonymous, \l_@@_anonymous_bool}
%    是否匿名评阅（盲审）。
%    \begin{macrocode}
    anonymous .bool_set:N = \l_@@_anonymous_bool,
    anonymous .default:n  = true,
    anonymous .initial:n  = false,
%    \end{macrocode}
% \end{macro}
%
% \begin{macro}{word-grid, \l_@@_word_grid_bool, word-grid-size}
%    是否启用类似 MS Word 文档网格的行为，以及若启用，以 bp 为单位给出网格间距的值。
%    \begin{macrocode}
    word-grid      .bool_set:N = \l_@@_word_grid_bool,
    word-grid      .initial:n  = true,
    word-grid-size .code:n     =
      {
        \fp_set:Nn \l_tmpa_fp {#1}
        \dim_set:Nn \l_@@_word_grid_size_dim
          { \fp_eval:n \l_tmpa_fp bp }
      },
    word-grid-size .initial:n = 15.6,
%    \end{macrocode}
% \end{macro}
%
% \subsubsection{其他未知选项 Other unknown options}
%    使用 \cs[no-index]{IfClassLoadedTF} 判定该未知选项是否是在加载本文档类时给出的。若
%    为加载时选项，则传给上游 \cls{ctexbook}，否则给出警告。
%    \begin{macrocode}
    unknown .code:n =
      {
        \IfClassLoadedTF { ctexbook }
          { \msg_warning:nn { pkuthss } { option-invalid } }
          { \PassOptionsToClass { \CurrentOption } { ctexbook } }
      },
%    \end{macrocode}
%
% \subsubsection{^^A
%   从标准文档类或 C\TeX{} 中去除的选项 Options removed from standard or C\TeX\
%   classes}
%    以下两个 C\TeX{} 选项 \pkg{pkuthss} 已经给定值，用户另行指定值无效，因此给出警告。
%    \begin{macrocode}
    zihao      .code:n = \msg_warning:nn { pkuthss } { option-preset },
    linespread .code:n = \msg_warning:nn { pkuthss } { option-preset },
%    \end{macrocode}
%
%    \begin{macrocode}
  }
%    \end{macrocode}
%
%    以下标准文档类选项由于格式要求，对 \pkg{pkuthss} 无意义，设置为无效。
%    \begin{macrocode}
\clist_map_inline:nn
  {
    a5paper , b5paper , letterpaper , legalpaper , executivepaper ,
    landscape ,
    10pt , 11pt , 12pt ,
    twoside , oneside ,
    titlepage , notitlepage ,
    onecolumn , twocolumn ,
    leqno ,
    openbib ,
%    \end{macrocode}
%    以及 C\TeX{} 的 \cmd[no-index]{scheme} 选项。
%    \begin{macrocode}
    scheme
  }
  {
    \@@_define_option:n
      {
        #1 .code:n  = \OptionNotUsed,
        #1 .usage:n = load,
      }
  }
%    \end{macrocode}
%
%
% \subsection{加载上游文档类与宏包 Loading upstream class and packages}
%    处理选项后加载 \cls{ctexbook}。
%    \begin{macrocode}
\ProcessKeyOptions [ pkuthss ]
\LoadClass [ a4paper , zihao = -4 , linespread = 1.0 ] { ctexbook }
%    \end{macrocode}
%
%    \begin{macrocode}
\RequirePackage { tabularx, multirow }
\RequirePackage { caption }
\RequirePackage [ \l_@@_footmisc_option_clist ] { footmisc }
\RequirePackage { etoolbox }
\RequirePackage { tikz }
\RequirePackage { unicode-math }
