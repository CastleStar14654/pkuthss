% \paragraph{数学字体}
%    选用字符覆盖较为完整的 XITS 系列。
%    \begin{macrocode}
\setmathfont { XITSMath-Regular.otf }
%    \end{macrocode}
%    XITS 表示分数线的斜杠过短、求和号稍小，用 Latin Modern 的字形替换。
%    \begin{macrocode}
\setmathfont { latinmodern-math.otf } [ range = { "002F, "2211 } ]
%    \end{macrocode}
%    使 \cs{mathcal} 字形正确映射。大写字形来自 XITS，更接近 \LaTeX{} 原本字形；小写字形
%    来自仅有提供此字形的 STIX2。
%    \begin{macrocode}
\setmathfont { XITSMath-Regular.otf }
  [ range = { cal/Latin, bfcal/Latin }, StylisticSet = 1 ]
\setmathfont { STIXTwoMath-Regular.otf }
  [ range = { cal/latin, bfcal/latin } ]
%    \end{macrocode}
