% \begin{templateinterfacedecl}{titlepage/thesis}
%    选项主要是本科生与研究生论文封面不同的竖直间距参数。
%    \begin{macrocode}
\DeclareTemplateInterface { titlepage } { thesis } { 0 }
  {
    thesis-name        : tokenlist,
    before-logo-skip   : skip      = 15.6bp,
    after-title-skip   : skip      = 0pt plus 1fill,
    after-meta-skip    : skip      = 39bp,
    after-degree-skip  : skip      = 19.5bp,
    after-date-skip    : skip      = 1.14803bp,
    show-english-title : boolean   = false,
    english-title-size : length    = 26bp,
    show-direction     : boolean   = true,
    show-degree-type   : boolean   = true
  }
