% \paragraph{无衬线字体}
%    直立体选用黑体，斜体选用楷体。
%
% \subparagraph{楷体}
%    类似仿宋的设置顺序，按照 Windows、Mac、文鼎 UKai、文鼎简中楷的顺序设置。作为最后备份，
%    文鼎简中楷使用文件名给定。
%
%    Mac 下的系统楷体有自带粗体字形，不需要设置伪粗体。
%    \begin{macrocode}
    \tl_set:Nn \l_@@_tmpb_tl { AutoFakeBold = 2 }
    \@@_fontset_case:nnn
      { \tl_set:Nn \l_@@_tmpa_tl { KaiTi } }
      {
        \tl_set:Nn \l_@@_tmpa_tl { Kaiti~SC }
        \tl_clear:N \l_@@_tmpb_tl
      }
