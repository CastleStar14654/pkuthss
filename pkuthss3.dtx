% \subsection{文档设置 Document layout}
% \subsubsection{字体 Font families}
%    警告信息。
%    \begin{macrocode}
\msg_new:nnn { pkuthss } { noto-not-found }
  {
    You~set~`fontset-use-noto'~option,~but~Noto~CJK~font~is~not~found.\\
    Use~Fandol~instead.
  }
%    \end{macrocode}
% \begin{macro}{\@@_fontset_case:nnn, \@@_fontset_song_hei_case:nnn}
%    三个参数分别对应 Windows（或 \opt{fontset-required}）、macOS、其他。仿宋/楷体完全根
%    据平台以及 \opt{fontset-required} 的值确定；宋体/黑体参照 \opt{fontset-use-noto}
%    的值。
%    \begin{macrocode}
\bool_lazy_or:nnTF
  { \sys_if_platform_windows_p: } { \l_@@_fontset_required_bool }
  {
    \cs_set_eq:NN \@@_fontset_case:nnn \use_i:nnn
  }
  {
    \ctex_if_platform_macos:TF
      { \cs_set_eq:NN \@@_fontset_case:nnn \use_ii:nnn }
      { \cs_set_eq:NN \@@_fontset_case:nnn \use_iii:nnn }
  }
\bool_if:NTF \l_@@_fontset_use_noto_bool
  { \cs_set_eq:NN \@@_fontset_song_hei_case:nnn \use_iii:nnn }
  {
    \cs_set_eq:NN \@@_fontset_song_hei_case:nnn
      \@@_fontset_case:nnn
  }
%    \end{macrocode}
% \end{macro}
%
%    如果用户没有指定 \opt{fontset} 选项，则进行自动配置。C\TeX{} 内部会将字体设置的参数
%    完全展开，因此不用做相关处理。
%    \begin{macrocode}
\bool_if:NF \l_@@_fontset_use_ctex_bool
  {
%    \end{macrocode}
% \paragraph{衬线字体}
%    直立体选用宋体，斜体选用仿宋。仿宋也设置为等宽字体。
%
% \subparagraph{仿宋}
%    \begin{macrocode}
    \@@_fontset_case:nnn
      { \tl_set:Nn \l_@@_tmpa_tl { FangSong } }
      { \tl_set:Nn \l_@@_tmpa_tl { STFangsong } }
      { \tl_set:Nn \l_@@_tmpa_tl { FandolFang-Regular.otf } }
    \setCJKfamilyfont { zhfs } { \l_@@_tmpa_tl } [ AutoFakeBold = 2 ]
    \setCJKmonofont   { \l_@@_tmpa_tl } [ AutoFakeBold = 2 ]
    \tl_set:Ne \l_@@_tmpa_tl
      {
        ItalicFont         = \l_@@_tmpa_tl,
        BoldItalicFont     = \l_@@_tmpa_tl,
        BoldItalicFeatures = { FakeBold = 2 }
      }
%    \end{macrocode}
% \subparagraph{宋体}
%    先默认设置成 Fandol，后按照 Windows/\opt{fontset-required}、Mac、Noto 的优先级顺
%    序覆盖；如果用户选择了 \opt{fontset-use-noto}，则 Noto 优先级最高。
%
%    Fandol 自带粗宋体。
%    \begin{macrocode}
    \@@_fontset_song_hei_case:nnn
      {
        \tl_set:Nn \l_@@_tmpb_tl { SimSun }
        \tl_set:Nn \l_@@_tmpc_tl { AutoFakeBold = 2 }
      }
      {
        \tl_set:Nn  \l_@@_tmpb_tl { Songti~SC }
        \tl_clear:N \l_@@_tmpc_tl
      }
      {
        \tl_set:Nn \l_@@_tmpb_tl { FandolSong-Regular.otf }
        \tl_set:Nn \l_@@_tmpc_tl { BoldFont = FandolSong-Bold.otf }
%    \end{macrocode}
%    较新版本的 Windows 自带了 Noto 区域变体。其他情况，需要检查完整 CJK 字体是否存在，使
%    用 \cs{l_@@_tmpa_bool} 表示。
%    \begin{macrocode}
        \bool_set_false:N \l_@@_tmpa_bool
        \sys_if_platform_windows:TF
          {
            \fontspec_font_if_exist:nTF { Noto~Serif~SC~Light }
              {
                \tl_set:Nn \l_@@_tmpb_tl { Noto~Serif~SC~Light }
                \tl_set:Nn \l_@@_tmpc_tl
                  { BoldFont = Noto~Serif~SC~SemiBold }
              }
              { \bool_set_true:N \l_@@_tmpa_bool }
          }
          { \bool_set_true:N \l_@@_tmpa_bool }
        \bool_if:NT \l_@@_tmpa_bool
          {
            \fontspec_font_if_exist:nF { Noto~Serif~CJK~SC~Light }
              {
                \bool_if:NT \l_@@_fontset_use_noto_bool
                  {
%    \end{macrocode}
%    使用临时变量 \cs{l_@@_tmpa_bool} 保存 Noto CJK 系列字体是否存在。
%
%    有可能用户使用的是非 Linux 系统下的 MiK\TeX{}，通过给出字体文件名促使自动安装
%    \pkg{notocjksc} 宏包。
%    \begin{macrocode}
                    \fontspec_font_if_exist:nF { NotoSerifCJKsc-Light.otf }
                      {
                        msg_warning:nn { pkuthss } { noto-not-found }
                        \bool_set_eq:NN \l_@@_tmpa_bool \c_false_bool
                      }
                  }
              }
            \bool_if:NT \l_@@_tmpa_bool
              {
                \tl_set:Nn \l_@@_tmpb_tl { Noto~Serif~CJK~SC~Light }
                \tl_set:Nn \l_@@_tmpc_tl
                  { BoldFont = Noto~Serif~CJK~SC~SemiBold }
              }
          }
      }
    \setCJKfamilyfont { zhsong }
      { \l_@@_tmpb_tl } [ \l_@@_tmpc_tl ]
    \setCJKmainfont   { \l_@@_tmpb_tl }
      [ \l_@@_tmpc_tl , \l_@@_tmpa_tl ]
